<!-- views/layouts/website.ejs -->
<!doctype html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/favicon" href="/favicon.ico" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <link rel="stylesheet" href="/dist/css/web.css">

  <title><%= title %></title>
</head>

<body class="d-flex flex-column min-vh-100 font-sans">

  <!-- Navbar -->
  <%- include("partials/_navbar") %>

  <!-- Menu mobile (Offcanvas o collapse de Bootstrap) -->
  <%- include("partials/_mobile_menu") %>

  <!-- Cuerpo principal -->
  <div class="container-fluid flex-grow-1 p-0">
    <div class="row g-0 h-100">

      <!-- Sidebar -->
      <div class="col-12 col-md-3 col-lg-2">
        <%- include("partials/_sidebar") %>
      </div>

      <!-- Contenido dinámico -->
      <main class="col-12 col-md-9 col-lg-10 d-flex flex-column bg-light">

        <div class="flex-grow-1 p-4">
          <%- body %>
        </div>

        <!-- Footer dentro del contenido -->
        <%- include("partials/_footer") %>

      </main>

    </div>
  </div>

  <script type="module" src="/dist/js/web.js"></script>

</body>

</html>