<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Arman Tsarukyan | Official Fan Page</title>

  <!-- Bootstrap 5 -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Bootstrap Icons -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
  >

  <style>
    body {
      background-color: #111;
      color: white;
      font-family: Arial, sans-serif;
    }

    .navbar {
      background-color: #000;
    }

    .hero {
      min-height: 85vh;
      display: flex;
      align-items: center;
      background:
        linear-gradient(90deg, rgba(0,0,0,0.95) 20%, rgba(0,0,0,0.4)),
        url("https://images.unsplash.com/photo-1549719386-74dfcbf7dbed?auto=format&fit=crop&w=1600&q=80");
      background-size: cover;
      background-position: center;
    }

    .hero h1 {
      font-size: 5rem;
      font-weight: 800;
    }

    .text-red {
      color: #dc3545;
    }

    .btn-danger {
      padding: 12px 28px;
      font-weight: bold;
    }

    .stat-card {
      background-color: #1c1c1c;
      border: none;
      border-radius: 12px;
      transition: transform 0.3s;
    }

    .stat-card:hover {
      transform: translateY(-8px);
    }

    .section-title {
      font-weight: 800;
      margin-bottom: 40px;
    }

    .news-card {
      background-color: #1c1c1c;
      border: none;
      overflow: hidden;
      transition: 0.3s;
    }

    .news-card:hover {
      transform: scale(1.03);
    }

    .news-card img {
      height: 220px;
      object-fit: cover;
    }

    footer {
      background-color: #000;
    }
  </style>
</head>

<body>

  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
    <div class="container">

      <a class="navbar-brand fw-bold fs-4" href="#">
        ARMAN <span class="text-danger">TSARUKYAN</span>
      </a>

      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#menu"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="menu">
        <ul class="navbar-nav ms-auto">

          <li class="nav-item">
            <a class="nav-link active" href="#inicio">Inicio</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="#sobre-mi">Sobre mí</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="#estadisticas">Estadísticas</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="#noticias">Noticias</a>
          </li>

        </ul>
      </div>

    </div>
  </nav>


  <!-- HERO -->
  <section class="hero" id="inicio">

    <div class="container">

      <div class="row">

        <div class="col-lg-7">

          <p class="text-danger fw-bold text-uppercase">
            UFC Lightweight Fighter
          </p>

          <h1>
            ARMAN<br>
            <span class="text-red">TSARUKYAN</span>
          </h1>

          <p class="lead text-light my-4">
            Velocidad. Técnica. Dominio.
            Conoce la trayectoria de uno de los peleadores más
            explosivos de la división de peso ligero.
          </p>

          <a href="#estadisticas" class="btn btn-danger me-2">
            Ver estadísticas
          </a>

          <a href="#sobre-mi" class="btn btn-outline-light">
            Conocer más
          </a>

        </div>

      </div>

    </div>

  </section>


  <!-- SOBRE ÉL -->
  <section class="py-5" id="sobre-mi">

    <div class="container py-5">

      <div class="row align-items-center">

        <div class="col-lg-6 mb-4">

          <h2 class="section-title">
            EL ASCENSO DE <span class="text-danger">ARMAN</span>
          </h2>

          <p class="text-secondary">
            Arman Tsarukyan es uno de los principales competidores
            de la división de peso ligero. Su estilo combina lucha,
            grappling y striking, convirtiéndolo en un rival
            completo dentro del octágono.
          </p>

          <p class="text-secondary">
            Con una trayectoria marcada por enfrentamientos de alto
            nivel, continúa consolidándose como una de las figuras
            más importantes de las MMA modernas.
          </p>

        </div>


        <div class="col-lg-6">

          <div class="row g-3" id="estadisticas">

            <div class="col-md-6">
              <div class="card stat-card text-center p-4 h-100">
                <h2 class="text-danger fw-bold">MMA</h2>
                <p class="text-secondary mb-0">
                  Peso Ligero
                </p>
              </div>
            </div>

            <div class="col-md-6">
              <div class="card stat-card text-center p-4 h-100">
                <h2 class="text-danger fw-bold">UFC</h2>
                <p class="text-secondary mb-0">
                  Competidor
                </p>
              </div>
            </div>

            <div class="col-md-6">
              <div class="card stat-card text-center p-4 h-100">
                <h2 class="text-danger fw-bold">
                  Wrestling
                </h2>
                <p class="text-secondary mb-0">
                  Base de combate
                </p>
              </div>
            </div>

            <div class="col-md-6">
              <div class="card stat-card text-center p-4 h-100">
                <h2 class="text-danger fw-bold">
                  Top Contender
                </h2>
                <p class="text-secondary mb-0">
                  Peso ligero
                </p>
              </div>
            </div>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- NOTICIAS -->
  <section class="py-5 bg-black" id="noticias">

    <div class="container py-5">

      <h2 class="section-title text-center">
        ÚLTIMAS <span class="text-danger">NOTICIAS</span>
      </h2>

      <div class="row g-4">

        <div class="col-md-4">

          <div class="card news-card h-100">

            <img
              src="https://images.unsplash.com/photo-1517438476312-10d79c077509?auto=format&fit=crop&w=800&q=80"
              alt="MMA Training"
            >

            <div class="card-body">

              <small class="text-danger">
                UFC NEWS
              </small>

              <h5 class="card-title mt-2">
                Preparación para el próximo desafío
              </h5>

              <p class="card-text text-secondary">
                Conoce más sobre el entrenamiento y la preparación
                detrás de cada pelea.
              </p>

            </div>

          </div>

        </div>


        <div class="col-md-4">

          <div class="card news-card h-100">

            <img
              src="https://images.unsplash.com/photo-1518605368461-929d5e1a2e52?auto=format&fit=crop&w=800&q=80"
              alt="Fighter"
            >

            <div class="card-body">

              <small class="text-danger">
                CAREER
              </small>

              <h5 class="card-title mt-2">
                El camino hacia la cima
              </h5>

              <p class="card-text text-secondary">
                Una trayectoria construida enfrentando a algunos de
                los mejores peleadores del mundo.
              </p>

            </div>

          </div>

        </div>


        <div class="col-md-4">

          <div class="card news-card h-100">

            <img
              src="https://images.unsplash.com/photo-1552072092-7f9b8d63efcb?auto=format&fit=crop&w=800&q=80"
              alt="MMA"
            >

            <div class="card-body">

              <small class="text-danger">
                TRAINING
              </small>

              <h5 class="card-title mt-2">
                Disciplina dentro y fuera del octágono
              </h5>

              <p class="card-text text-secondary">
                Fuerza, resistencia y técnica como pilares del alto
                rendimiento.
              </p>

            </div>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- FOOTER -->
  <footer class="py-4">

    <div class="container text-center">

      <h5 class="fw-bold">
        ARMAN <span class="text-danger">TSARUKYAN</span>
      </h5>

      <p class="text-secondary mb-0">
        Fan website • Built with Bootstrap 5
      </p>

    </div>

  </footer>


  <!-- Bootstrap JS -->
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
  </script>

</body>
</html>